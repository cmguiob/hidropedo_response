### ----muestreo_inhibido_rssi----------------------------------------------------------------------------------
# Paso 1: Asegurarse de tener coordenadas válidas para el muestreo
# Estas ya fueron creadas previamente como `val_coords` a partir de `cobertura_final`
# Se asume que están en EPSG:4326 y se transformarán a metros (EPSG:3857)
# Convertir coordenadas válidas a sf y proyectar
val_coords_sf <- sf::st_as_sf(val_coords, coords = c("x", "y"), crs = 4326)
val_coords_proj <- sf::st_transform(val_coords_sf, 3857)
# Extraer coordenadas proyectadas
val_coords_mat <- sf::st_coordinates(val_coords_proj)
# Paso 2: Crear ventana de muestreo a partir del polígono de Colombia ya proyectado (EPSG:3857)
# Se asume que ya existe el objeto `colombia_proj` (sf en EPSG:3857) creado anteriormente
colombia_sp <- as(colombia_proj, "Spatial")                   # Convertir a clase Spatial
owin_col <- spatstat.geom::as.owin(colombia_sp)              # Convertir a ventana spatstat
# Convertir polígono de Colombia (sf en EPSG:3857) a ventana owin robustamente
# 1. Unificar geometrías si hay múltiples features (evita errores por polígonos múltiples)
colombia_union <- sf::st_union(colombia_proj)
# 2. Asegurarse que sea válido
colombia_union <- sf::st_make_valid(colombia_union)
# 3. Convertir a ventana owin directamente desde sf
owin_col <- spatstat.geom::as.owin(colombia_union)
### ----muestreo_inhibido_rssi----------------------------------------------------------------------------------
## ----muestreo_ppp_preparacion_completo----------------------------------------------------------------------
# Paso 1: Convertir coordenadas válidas de cobertura_final a objeto sf y proyectarlas a EPSG:3857
val_coords_sf <- sf::st_as_sf(val_coords, coords = c("x", "y"), crs = 4326)
val_coords_proj <- sf::st_transform(val_coords_sf, 3857)
# Extraer coordenadas como matriz para usarlas con ppp()
val_coords_mat <- sf::st_coordinates(val_coords_proj)
# Paso 2: Preparar el polígono de Colombia como ventana owin (en metros)
# Se parte del objeto `colombia_proj` ya en EPSG:3857
# 2.1 Unificar geometrías si hay múltiples features
colombia_union <- sf::st_union(colombia_proj)
# 2.2 Validar geometría para evitar errores de topología
colombia_union <- sf::st_make_valid(colombia_union)
# 2.3 Convertir a ventana 'owin' directamente desde objeto sf
owin_col <- spatstat.geom::as.owin(colombia_union)
# Paso 3: Crear objeto ppp con los píxeles válidos dentro del polígono de Colombia
coords_ppp <- spatstat.geom::ppp(
x = val_coords_mat[, "X"],
y = val_coords_mat[, "Y"],
window = owin_col
)
# Verificación
cat("✔️ Objeto ppp creado correctamente con", coords_ppp$n, "puntos válidos\n")
set.seed(123)
muestreo <- spatstat.random::rSSI(
r = 10000,         # distancia mínima entre puntos en metros
giveup = 10000,    # intentos máximos antes de detener el algoritmo
win = coords_ppp$window,
nsim = 1
)
knitr::purl('01_procesamiento_eda_SMAP.qmd')
# Paso 4: Ejecutar muestreo inhibido con separación mínima de 10 km
set.seed(123)
muestreo <- spatstat.random::rSSI(
r = 10000,
giveup = 10000,
win = coords_ppp$window,
nsim = 1
)
cat("✔️ Puntos de muestreo generados:", muestreo$n, "\n")
# Paso 5: Crear objeto sf temporal en EPSG:9377 (CRS plano de trabajo)
muestreo_sf_tmp <- sf::st_as_sf(
data.frame(x = muestreo$x, y = muestreo$y),
coords = c("x", "y"),
crs = 9377
)
# Paso 6: Transformar a EPSG:4326 para análisis, visualización y GEE
muestreo_sf <- sf::st_transform(muestreo_sf_tmp, 4326)
# Paso 7: Visualizar puntos sobre el polígono de Colombia
plot(st_geometry(colombia), border = "gray60", lwd = 1.2,
main = "Puntos de muestreo espacial (EPSG:4326)")
# Convertir el SpatVector 'colombia' a objeto sf en EPSG:4326 (si aún no lo habías hecho)
colombia_sf <- sf::st_as_sf(colombia)
# Visualizar puntos muestreados sobre el polígono de Colombia
plot(st_geometry(colombia_sf), border = "gray60", lwd = 1.2,
main = "Puntos de muestreo espacial (EPSG:4326)")
plot(st_geometry(muestreo_sf), add = TRUE, col = "darkblue", pch = 16, cex = 0.6)
# Visualizar puntos muestreados sobre el polígono de Colombia
plot(st_geometry(colombia_sf), border = "gray60", lwd = 1.2,
main = "Puntos de muestreo espacial (EPSG:4326)")
plot(st_geometry(muestreo_sf), add = TRUE, col = "darkblue", pch = 16, cex = 0.6)
# Paso 1: Plot base (polígono de Colombia)
plot(colombia_sf["geometry"], border = "gray60", lwd = 1.2,
main = "Puntos de muestreo espacial (EPSG:4326)")
# Paso 2: Añadir puntos muestreados
plot(muestreo_sf["geometry"], add = TRUE, col = "darkblue", pch = 16, cex = 0.6)
# Paso 1: Asegurar que los objetos están en EPSG:4326
# (Si ya los tienes transformados, esto no hace nada)
colombia_sf_4326 <- sf::st_transform(colombia_sf, 4326)
muestreo_sf_4326 <- sf::st_transform(muestreo_sf, 4326)
# Paso 2: Visualización con ggplot2
ggplot() +
geom_sf(data = colombia_sf_4326, fill = "gray95", color = "gray60", linewidth = 0.4) +
geom_sf(data = muestreo_sf_4326, color = "darkblue", size = 0.3, alpha = 0.8) +
coord_sf(datum = sf::st_crs(4326)) +
theme_minimal(base_size = 13) +
labs(
title = "Puntos de muestreo espacial sobre cobertura SMAP válida",
subtitle = "Coordenadas geográficas (EPSG:4326)",
caption = "Fuente: SMAP NSIDC-0779 y máscara de cobertura válida"
)
crs(cobertura_final)
# 1. Cargar raster de cobertura válida SMAP
cobertura_final <- terra::rast(here::here("Data", "SMAP_cobertura_valida_ambos_periodos.tif"))
# 2. Convertir SpatRaster a RasterLayer (requerido por spatstat)
cobertura_raster <- raster::raster(cobertura_final)
# 3. Convertir raster binario (TRUE/FALSE) a ventana owin
owin_valida <- spatstat.geom::as.owin(cobertura_raster)
# 2. Convertir zonas TRUE a polígonos (terra → sf)
poligono_valido <- cobertura_final |>
terra::as.polygons(na.rm = TRUE, dissolve = TRUE) |>
sf::st_as_sf()
# 3. Unificar geometría y validar
poligono_valido <- sf::st_make_valid(sf::st_union(poligono_valido))
# 4. Convertir a owin
owin_valida <- spatstat.geom::as.owin(poligono_valido)
# 2. Convertir zonas TRUE a polígonos (terra → sf)
poligono_valido <- cobertura_final |>
terra::as.polygons(na.rm = TRUE, dissolve = TRUE) |>
sf::st_as_sf()
# 3. Reproyectar a sistema métrico (EPSG:9377)
poligono_valido_proj <- sf::st_transform(poligono_valido, 9377)
# 4. Unificar geometrías y validar
poligono_valido_proj <- sf::st_make_valid(sf::st_union(poligono_valido_proj))
# 5. Convertir a owin (ahora sí funciona)
owin_valida <- spatstat.geom::as.owin(poligono_valido_proj)
# 1. Ejecutar el muestreo inhibido
set.seed(123)
muestreo <- spatstat.random::rSSI(
r = 10000,           # separación mínima: 10 km
giveup = 10000,
win = owin_valida,
nsim = 1
)
muestreo <- spatstat.random::rSSI(
r = 10000,           # separación mínima: 10 km
giveup = 10000,
win = owin_valida,
nsim = 1
)
cat("✔️ Puntos de muestreo generados:", muestreo$n, "\n")
# 2. Convertir los puntos a sf en EPSG:9377 (coincide con la ventana)
muestreo_sf_proj <- sf::st_as_sf(
data.frame(x = muestreo$x, y = muestreo$y),
coords = c("x", "y"),
crs = 9377
)
# 3. Transformar a EPSG:4326 para compatibilidad con SMAP y GEE
muestreo_sf <- sf::st_transform(muestreo_sf_proj, 4326)
# 4. Preparar raster como sf para superponer en ggplot
cobertura_sf <- cobertura_final |>
terra::as.polygons(na.rm = TRUE) |>
sf::st_as_sf() |>
dplyr::mutate(valor = 1)
ibrary(ggplot2)
ggplot() +
geom_sf(data = cobertura_sf, fill = "gray90", color = NA) +
geom_sf(data = muestreo_sf, color = "darkblue", size = 0.3, alpha = 0.8) +
coord_sf(crs = 4326) +
theme_minimal(base_size = 13) +
labs(
title = "Puntos de muestreo espacial sobre cobertura SMAP válida",
subtitle = "Zonas válidas según cobertura_final (EPSG:4326)",
caption = "Patrón rSSI con separación de 10 km"
)
